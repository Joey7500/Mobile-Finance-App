# Copy this file to `keystore.properties` (same folder) and fill in YOUR values.
# `keystore.properties` is git-ignored and blocked by the pre-commit hook:
# it must never be committed. This example file contains no real values.
#
# storeFile may be absolute or relative to the project root. Keep the .jks
# OUTSIDE the repository folder (e.g. in your user folder), and back it up:
# without it you cannot update the installed app without losing its data.

storeFile=C:/Users/YOUR_NAME/keys/vaultflow-release.jks
storePassword=CHANGE_ME
keyAlias=vaultflow
keyPassword=CHANGE_ME
